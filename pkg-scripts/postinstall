#!/bin/bash
# Run the patch as the logged-in desktop user, never as root against their
# Steam library. Installer files are removed on both success and failure.
set -u

DIR='/Library/Application Support/SlayTheSpire-Modern-Installer'
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
RUN_INSTALLER="$SCRIPT_DIR/run-installer.sh"
cleanup() { rm -rf "$DIR" 2>/dev/null || true; }
trap cleanup EXIT

[ -d "$DIR" ] && [ ! -L "$DIR" ] || {
  echo '[sts-modern] invalid or missing package payload directory' >&2
  exit 1
}
[ -x "$DIR/install.sh" ] || {
  echo '[sts-modern] package install.sh is missing or not executable' >&2
  exit 1
}
[ -x "$RUN_INSTALLER" ] || {
  echo '[sts-modern] package status runner is missing or not executable' >&2
  exit 1
}

CONSOLE_USER="$(stat -f %Su /dev/console 2>/dev/null || true)"
case "$CONSOLE_USER" in
  ''|root|loginwindow)
    echo '[sts-modern] no logged-in desktop user; sign in and run the package again' >&2
    exit 1
    ;;
esac

USER_HOME="$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
[ -n "$USER_HOME" ] || {
  echo '[sts-modern] could not determine the console user home directory' >&2
  exit 1
}
USER_UID="$(id -u "$CONSOLE_USER")" || exit 1

chmod -R a+rX "$DIR" || exit 1
INSTALL_RC=0
"$RUN_INSTALLER" \
  launchctl asuser "$USER_UID" sudo -u "$CONSOLE_USER" \
  env HOME="$USER_HOME" USER="$CONSOLE_USER" LOGNAME="$CONSOLE_USER" \
  "$DIR/install.sh" || INSTALL_RC=$?

# Do not leave a trailing test expression here. PackageKit must receive the
# exact install.sh status: zero for success, non-zero for a safety refusal.
exit "$INSTALL_RC"
